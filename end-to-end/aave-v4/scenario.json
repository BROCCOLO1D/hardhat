{
  "$schema": "../../scripts/end-to-end/schema/scenario.schema.json",
  "description": "Aave v4 fork to Hardhat 3.",
  "tags": ["external-repo"],
  "repo": "anaPerezGhiglia/aave-v4",
  "commit": "e141a050313f9e2ed30aa90cdb23fd300e65a1b6",
  "packageManager": "yarn",
  "submodules": true,
  "env": {
    "PATH": "${localEnv:HOME}/.foundry/bin:${localEnv:PATH}"
  },
  "preinstall": "./preinstall-foundry.sh",
  "defaultCommand": "npx hardhat test solidity",
  "benchmark": {
    "commands": {
      "forge build (cold)": {
        "runs": 3,
        "prepare": "forge clean",
        "command": "forge build"
      },
      "forge build (warm)": {
        "runs": 39,
        "command": "forge build"
      },
      "forge test": {
        "runs": 3,
        "command": "forge test"
      }
    }
  }
}
